# Copy to standin/.env (git-ignored) or let standin/up.sh generate it.
# Docker Compose reads this file automatically from the compose project dir.

# Required: LiteLLM master key (any string; clients send "Authorization: Bearer <key>").
LITELLM_MASTER_KEY=sk-standin-change-me

# Optional overrides (defaults shown).
#STANDIN_MODEL=qwen2.5-1.5b-instruct
#STANDIN_HF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
#STANDIN_HF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
#STANDIN_MODEL_CACHE=./.cache/models
#STANDIN_LLAMA_PORT=8080
#STANDIN_LITELLM_PORT=4000
#STANDIN_LLAMA_THREADS=-1
#STANDIN_LITELLM_LOG=INFO
#HF_TOKEN=
